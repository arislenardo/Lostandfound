rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- HELPER FUNCTION ---
    function isAdmin() {
      return exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /users/{userId} {
      allow read, write: if request.auth != null;
    }
    
    match /claims/{claimId} {
      allow read, write: if request.auth != null;
    }

    match /found_items/{itemId} {
      allow read: if true;
      allow create, update: if request.auth != null;
      allow delete: if request.auth != null && (request.auth.uid == resource.data.userId || isAdmin());
    }
    
    match /lost_items/{itemId} {
      allow read: if true;
      allow create, update: if request.auth != null;
      allow delete: if request.auth != null && (request.auth.uid == resource.data.userId || isAdmin());
    }

    match /admins/{adminId} {
      allow read: if true;
      allow write: if false; 
    }
    
    match /messages/{messageId} {
      allow read, write: if request.auth != null;
    }
    
    match /match_notifications/{notificationId} {
      allow read, write: if request.auth != null;
    }

    match /closed_chats/{chatId} {
      allow read, write: if request.auth != null;
    }

    match /claim_notifications/{notificationId} {
      allow read, write: if request.auth != null;
    }

    match /admin_history/{documentId} {
      allow read, write: if request.auth != null && isAdmin();
    }
  }
}
